{
  "name": "wallhammerzero",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "wallhammerzero",
      "version": "0.0.0",
      "workspaces": [
        "tools/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=24"
      }
    },
    "node_modules/@whz/check": {
      "resolved": "tools/check",
      "link": true
    },
    "node_modules/@whz/dev-env": {
      "resolved": "tools/dev-env",
      "link": true
    },
    "tools/check": {
      "name": "@whz/check",
      "version": "0.0.0"
    },
    "tools/dev-env": {
      "name": "@whz/dev-env",
      "version": "0.0.0"
    }
  }
}
