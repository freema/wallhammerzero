<Project Sdk="Microsoft.NET.Sdk">
  <!-- Analysis driver written for the Wallhammer Zero review (our own code, kept for reproducibility only; not a WZ package).
       Links the third-party Core sources from the read-only mount at /src, like tools/core_harness does. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="/src/addons/procedural_creatures/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="/src/addons/procedural_creatures_plantfolk/Core/**/*.cs" LinkBase="Plantfolk" />
  </ItemGroup>
</Project>
