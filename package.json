{
  "name": "wallhammerzero",
  "version": "0.0.0",
  "private": true,
  "description": "Wallhammer Zero: a studio + generator for games written entirely by an AI.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "tools/*",
    "packages/*"
  ],
  "scripts": {
    "asset": "node packages/asset-kit/src/node/bin.ts",
    "audio": "node packages/audio/src/node/bin.ts",
    "check": "node tools/check/run.mjs",
    "check:assets": "tsc --noEmit -p assets && eslint assets && node packages/asset-kit/src/node/bin.ts lint --all --no-write",
    "city": "node packages/citygen/src/node/bin.ts",
    "game": "node packages/game-data/src/node/bin.ts",
    "sim": "node packages/sim/src/node/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
